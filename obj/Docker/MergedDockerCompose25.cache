name: dockercompose9759386140812254811
services:
  api:
    build:
      context: C:\Users\USER\source\repos\cente-shop
      dockerfile: Bootstrapper/Api/Dockerfile
    container_name: centeshop_api
    depends_on:
      centeshopdb:
        condition: service_started
        required: true
    environment:
      ASPNETCORE_ENVIRONMENT: Development
      ConnectionStrings__DefaultConnection: Host=centeshopdb;Port=5432;Database=Centeshopdb;Username=cente;Password=cente2025
    networks:
      default: null
    ports:
      - mode: ingress
        target: 8080
        published: "8080"
        protocol: tcp
      - mode: ingress
        target: 8081
        published: "8081"
        protocol: tcp
    volumes:
      - type: bind
        source: C:\Users\USER\source\repos\cente-shop\Bootstrapper\Api
        target: /app
        bind:
          create_host_path: true
      - type: bind
        source: C:\Users\USER\.aspnet\https
        target: /https
        read_only: true
        bind:
          create_host_path: true
  centeshopdb:
    container_name: centeshopdb
    environment:
      POSTGRES_DB: Centeshopdb
      POSTGRES_PASSWORD: cente2025
      POSTGRES_USER: cente
    image: postgres:latest
    networks:
      default: null
    ports:
      - mode: ingress
        target: 5432
        published: "5432"
        protocol: tcp
    volumes:
      - type: volume
        source: postgres_centeshopdb
        target: /var/lib/postgresql/data
        volume: {}
networks:
  default:
    name: dockercompose9759386140812254811_default
volumes:
  postgres_centeshopdb:
    name: dockercompose9759386140812254811_postgres_centeshopdb